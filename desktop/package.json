{
  "name": "momo-desktop",
  "productName": "momo",
  "version": "0.1.0",
  "description": "momo's desktop app: the same server and web app, in a native window with tabs.",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node tools/check.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "io.github.alx-kap.momo",
    "productName": "momo",
    "files": [
      "src/**/*",
      "build/icon.svg",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance"
    }
  }
}
