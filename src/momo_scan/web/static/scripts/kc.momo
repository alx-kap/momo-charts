#momo 1
indicator("Keltner Channels", overlay=true, short="KC")

length = input.int(20, "Length", min=2, max=500)
mult = input.float(2.0, "Multiplier", min=0.1, max=10, step=0.1)
atr_length = input.int(10, "ATR length", min=1, max=500)

basis, upper, lower = ta.kc(close, length, mult, atr_length)

plot(basis, "Basis", color="#2962ff")
plot(upper, "Upper", color="#2962ff")
plot(lower, "Lower", color="#2962ff")
