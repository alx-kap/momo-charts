#momo 1
indicator("MACD", overlay=false, short="MACD")

fast = input.int(12, "Fast", min=1, max=500)
slow = input.int(26, "Slow", min=1, max=500)
smooth = input.int(9, "Signal", min=1, max=500)
rising = input.color("#26a69a", "Histogram rising")
falling = input.color("#ef5350", "Histogram falling")

macd_line, signal_line, hist = ta.macd(close, fast, slow, smooth)

plot(hist, "Histogram", color=rising if hist >= 0 else falling, style="histogram")
plot(macd_line, "MACD", color="#2962ff")
plot(signal_line, "Signal", color="#ff6d00")
hline(0, "Zero", color="#787b86")
