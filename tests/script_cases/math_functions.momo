#momo 1
indicator("T", overlay=true)
plot(math.abs(close - open), "abs")
plot(min(close, open), "min")
plot(max(close, open, 4), "max3")
plot(round(close), "round")
plot(math.floor(close), "floor")
plot(math.ceil(close), "ceil")
plot(math.sqrt(close * 2), "sqrt")
plot(math.pow(close, 2), "pow")
plot(math.sign(close - open), "sign")
plot(math.clamp(close, 2, 5), "clamp")
plot(math.round(close / 3, 2), "round2")
plot(math.exp(0), "exp")
plot(math.log(math.exp(1)), "log")
