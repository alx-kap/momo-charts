#momo 1
indicator("Number formats")
a = 0.5
b = 2.675
c = 1e21
d = 1e-7
e = 123456.789
f = -0.0000001
g = 1234567.891
h = 1e15
k = 0.1 + 0.2
if last_bar:
    log(f"{a} {b} {c} {d} {e} {f} {g} {h} {k}")
    log(f"{a:.0f} {b:.2f} {e:,.0f} {g:,.2f} {f:.3f} {h:,}")
    log(f"{a:%} {b:.1%} {d:.4%} {e:,.1%}")
    log(f"{close:.2f} {1 / 0} {-1.5:.0f} {2.5:.0f} {0.045:.2f} {1.005:.2f}")
plot(close, "c")
