#momo 1
indicator("T", overlay=true)
length = input.int(3, "Length", min=1, max=10)
src = input.source(close, "Source")
mult = input.float(2.0, "Mult")
on = input.bool(true, "On")
mode = input.choice("a", "Mode", options=["a", "b"])
tint = input.color("#ff0000", "Tint")
plot(ta.sma(src, length) * mult if on else 0, "v", color=tint)
plot(1 if mode == "b" else 0, "mode")
